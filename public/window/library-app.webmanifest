{
  "id": "/window/reference-library",
  "name": "Jupiter Astrology Library",
  "short_name": "Library",
  "description": "A standalone window for the Jupiter Astrology Library.",
  "start_url": "/window/library-app.html",
  "scope": "/window/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "fullscreen"
  ],
  "orientation": "any",
  "background_color": "#fbfaf8",
  "theme_color": "#f4f2ee",
  "icons": [
    {
      "src": "/window/library-icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/window/library-icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
